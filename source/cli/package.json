    "lispex": "bin/lispex.js"
  },
  "files": [
    "bin/lispex.js",
    "pkg/lispex_wasm.js",
    "pkg/lispex_wasm_bg.wasm",
    "pkg/lispex_wasm.d.ts",
    "pkg/lispex_wasm_bg.wasm.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lispex",
    "lisp",
    "scheme",
    "r7rs",
    "interpreter",
    "wasm",
    "webassembly",
    "receipts",
    "verify",
    "replay",
    "vouch-bridge"
  ],
  "homepage": "https://artifact.invalid/lispex"
}
