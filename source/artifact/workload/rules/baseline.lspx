(define exact-five?
  (lambda (xs)
    (if (pair? xs)
      (if (pair? (cdr xs))
          (if (pair? (cdr (cdr xs)))
              (if (pair? (cdr (cdr (cdr xs))))
                  (if (pair? (cdr (cdr (cdr (cdr xs)))))
                      (null? (cdr (cdr (cdr (cdr (cdr xs))))))
                      #f)
                  #f)
              #f)
          #f)
      #f)))
(define exact-integer-five?
  (lambda (xs)
    (if (exact-integer? (car xs))
        (if (exact-integer? (car (cdr xs)))
            (if (exact-integer? (car (cdr (cdr xs))))
                (if (exact-integer? (car (cdr (cdr (cdr xs)))))
                    (exact-integer? (car (cdr (cdr (cdr (cdr xs))))))
                    #f)
                #f)
            #f)
        #f)))
(define known-period? (lambda (x) (if (= x 2025) #t (= x 2026))))
(define known-household?
  (lambda (x) (if (= x 0) #t (if (= x 1) #t (if (= x 2) #t (= x 3))))))
(define known-dependents?
  (lambda (x) (if (= x 0) #t (if (= x 1) #t (= x 2)))))
(define known-residency? (lambda (x) (if (= x 0) #t (= x 1))))
(define decide-amount
  (lambda (amount)
    (if (< amount 0)
      (decision-invalid-input)
      (if (> amount 1000000)
          (decision-invalid-input)
          (if (< amount 100156)
              (decision-deny)
              (if (< amount 200156)
                  (decision-review)
                  (if (< amount 300156)
                      (decision-approve)
                      (if (< amount 400153)
                          (decision-approve)
                          (if (< amount 500156)
                              (decision-review)
                              (if (< amount 600156) (decision-deny) (decision-deny)))))))))))
(if (exact-five? input)
    (if (exact-integer-five? input)
        (if (known-period? (car input))
            (if (known-household? (car (cdr input)))
                (if (known-dependents? (car (cdr (cdr input))))
                    (if (known-residency? (car (cdr (cdr (cdr input)))))
                        (decide-amount (car (cdr (cdr (cdr (cdr input))))))
                        (decision-invalid-input))
                    (decision-invalid-input))
                (decision-invalid-input))
            (decision-invalid-input))
        (decision-invalid-input))
    (decision-invalid-input))
