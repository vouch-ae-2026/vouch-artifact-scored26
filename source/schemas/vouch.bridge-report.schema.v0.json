{
  "$id": "vouch.bridge-report.schema.v0",
  "title": "Vouch Bridge Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_report",
    "profile",
    "engine",
    "subject",
    "checks",
    "linked_artifacts",
    "summary",
    "boundary",
    "diagnostics"
  ],
  "properties": {
    "bridge_report": {
      "const": "vouch.bridge-report/v0"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {
          "const": "conversion-evidence"
        },
        "version": {
          "const": "v0"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vcs", "hex", "dirty"],
          "properties": {
            "vcs": {
              "const": "git"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty": {
              "const": false
            }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "case_id", "source", "target", "route"],
      "properties": {
        "kind": {
          "const": "source-to-target-conversion"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/externalFile"
        },
        "target": {
          "$ref": "#/$defs/externalFile"
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "checked_profile", "capability_ids"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "checked_profile": {
              "type": "string",
              "minLength": 1
            },
            "capability_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "status", "artifact_hash"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["pass", "fail", "not-run"]
          },
          "artifact_hash": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/linkedHash"
              }
            ]
          }
        }
      }
    },
    "linked_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "disclosure", "hash"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disclosure": {
            "enum": ["hash-only", "public-bytes"]
          },
          "hash": {
            "$ref": "#/$defs/linkedHash"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "check_count", "failed_checks", "not_run_checks"],
      "properties": {
        "status": {
          "enum": ["pass", "fail"]
        },
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_checks": {
          "type": "integer",
          "minimum": 0
        },
        "not_run_checks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attests", "excludes"],
      "properties": {
        "attests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "externalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "path", "byte_len", "hash"],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byte_len": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "domain", "hex"],
      "properties": {
        "algo": {
          "const": "sha-256"
        },
        "domain": {
          "enum": [
            "vouch/external-source-hash/v0",
            "vouch/external-target-hash/v0"
          ]
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "linkedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "domain", "hex"],
      "properties": {
        "algo": {
          "const": "sha-256"
        },
        "domain": {
          "const": "vouch/linked-artifact-hash/v0"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
