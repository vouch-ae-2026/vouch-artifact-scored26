{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vouch.generated-disjointness.schema.v0",
  "title": "Vouch Generated Disjointness v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_disjointness",
    "version",
    "generator",
    "properties",
    "summary",
    "cases",
    "boundary"
  ],
  "properties": {
    "generated_disjointness": {
      "const": "vouch.generated-disjointness/v0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object"
    },
    "properties": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "coverage",
        "native_accepts",
        "bridge_accepts",
        "native_exit_code",
        "bridge_exit_code",
        "native_failure_head",
        "bridge_failure_head"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "native_accepts": {
          "type": "boolean"
        },
        "bridge_accepts": {
          "type": "boolean"
        },
        "native_exit_code": {
          "type": "integer"
        },
        "bridge_exit_code": {
          "type": "integer"
        },
        "native_failure_head": {
          "type": "array"
        },
        "bridge_failure_head": {
          "type": "array"
        }
      }
    }
  }
}
