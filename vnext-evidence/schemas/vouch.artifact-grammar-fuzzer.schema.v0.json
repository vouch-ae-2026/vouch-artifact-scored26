{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vouch.artifact-grammar-fuzzer.schema.v0",
  "title": "Vouch Artifact Grammar Fuzzer v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_grammar_fuzzer",
    "version",
    "generator",
    "properties",
    "summary",
    "cases",
    "boundary"
  ],
  "properties": {
    "artifact_grammar_fuzzer": {
      "const": "vouch.artifact-grammar-fuzzer/v0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object"
    },
    "properties": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_class",
        "mutation",
        "coverage",
        "entrypoints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entrypoint"
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expected_accept",
        "actual_accept",
        "exit_code",
        "expected_failure",
        "failure_head"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected_accept": {
          "type": "boolean"
        },
        "actual_accept": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "expected_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_head": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
