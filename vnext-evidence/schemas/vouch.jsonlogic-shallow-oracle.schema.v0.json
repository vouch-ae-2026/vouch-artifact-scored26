{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vouch.jsonlogic-shallow-oracle.schema.v0",
  "title": "Vouch JSON Logic Shallow Oracle v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonlogic_shallow_oracle",
    "version",
    "generator",
    "rules",
    "cases",
    "partiality_audit",
    "summary",
    "boundary"
  ],
  "properties": {
    "jsonlogic_shallow_oracle": {
      "const": "vouch.jsonlogic-shallow-oracle/v0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object"
    },
    "rules": {
      "type": "array"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "partiality_audit": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "rule_id",
        "input_hash",
        "input_datum",
        "upstream_input",
        "upstream_output",
        "mapped_upstream_decision",
        "lispex_transcript",
        "receipt_comparison_status",
        "fault_class",
        "outcome",
        "first_divergence",
        "cause",
        "resolution"
      ],
      "properties": {
        "case_id": {
          "type": "object"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "object"
        },
        "input_datum": {
          "type": "string"
        },
        "upstream_input": {
          "type": "object"
        },
        "upstream_output": {},
        "mapped_upstream_decision": {
          "type": "string"
        },
        "lispex_transcript": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipt_comparison_status": {
          "type": "string"
        },
        "fault_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "agree",
            "disagree",
            "not-run"
          ]
        },
        "first_divergence": {
          "type": [
            "object",
            "null"
          ]
        },
        "cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
