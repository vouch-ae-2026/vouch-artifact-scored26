{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vouch.seeded-divergence.schema.v0",
  "title": "Vouch Seeded Divergence v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seeded_divergence",
    "version",
    "seed",
    "source",
    "artifact",
    "injection",
    "expected",
    "boundary"
  ],
  "properties": {
    "seeded_divergence": {
      "const": "vouch.seeded-divergence/v0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "artifact": {
      "$ref": "#/$defs/file"
    },
    "injection": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
