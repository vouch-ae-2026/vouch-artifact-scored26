{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vouch.mutation-generator.schema.v0",
  "title": "Vouch Mutation Generator v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation_generator",
    "version",
    "generator",
    "properties",
    "summary",
    "cases",
    "boundary"
  ],
  "properties": {
    "mutation_generator": {
      "const": "vouch.mutation-generator/v0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object"
    },
    "properties": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "property",
        "artifact_class",
        "mutation_class",
        "gate",
        "expected_failure",
        "future_expected_failure",
        "future_work_id",
        "actual_accept",
        "exit_code",
        "failure_head",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "active",
            "expected-fail-documented"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "type": "string",
          "minLength": 1
        },
        "mutation_class": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "expected_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "future_expected_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "future_work_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_accept": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "failure_head": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "caught",
            "not-caught",
            "caught-with-wrong-failure-class",
            "expected-fail-documented"
          ]
        }
      }
    }
  }
}
